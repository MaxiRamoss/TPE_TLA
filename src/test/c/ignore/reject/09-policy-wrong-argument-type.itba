// El primer argumento de Extender es la intersección B, pero el parámetro principal es una calle.
simulation S { duration 1 h }
intersection A at (0 m, 0 m)
intersection B at 100 m east of A
intersection C at 100 m east of B
road AB from A to B
policy Extender(road principal, integer umbral) {
	if queue(principal) > umbral {
		extend principal by 10 s
	}
}
light L at B {
	phase green for AB during 30 s
	apply Extender(B, 15)
}
